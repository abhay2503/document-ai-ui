# Base URL of the DocuMind AI API (your API Gateway stage URL).
# Copy this file to .env.local, fill it in, then restart `npm run dev`.
# Example: https://abc123.execute-api.ap-south-1.amazonaws.com/prod
NEXT_PUBLIC_API_BASE_URL=

# Cognito (existing User Pool + public App Client, no secret, no Identity Pool)
# Domain WITHOUT https://, e.g. your-prefix.auth.ap-south-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
# Must exactly match the callback / sign-out URLs on the App Client.
# Production: https://main.d1q6ica46vdxge.amplifyapp.com
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000
